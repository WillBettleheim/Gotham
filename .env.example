# Copy this file to .env and fill in whichever keys you have.
# Any resident whose key is missing still lives in town, using built-in offline chatter.

# Claude (Ophelia, Orion, Sonny, Sage, Selene, Hana, Hugo, Hazel) - https://platform.claude.com
ANTHROPIC_API_KEY=

# Google Gemini (Nova) - FREE key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Groq (FREE key at https://console.groq.com/keys) powers:
#   Lola - Meta Llama
#   Gus  - OpenAI's open GPT-OSS model (unless OPENAI_API_KEY is set)
GROQ_API_KEY=

# Mistral (Mira) - free "Experiment" plan at https://console.mistral.ai
MISTRAL_API_KEY=

# DeepSeek (Dex) - very cheap pay-as-you-go at https://platform.deepseek.com
DEEPSEEK_API_KEY=

# Optional: use OpenAI directly for Gus instead of GPT-OSS on Groq (paid)
OPENAI_API_KEY=

# Optional model overrides (free model names change often)
# GEMINI_MODEL=gemini-3.5-flash
# GROQ_LLAMA_MODEL=llama-3.3-70b-versatile
# GROQ_GPT_MODEL=openai/gpt-oss-120b
# OPENAI_MODEL=gpt-5-mini
# MISTRAL_MODEL=mistral-small-latest
# DEEPSEEK_MODEL=deepseek-chat

# PORT=3000
